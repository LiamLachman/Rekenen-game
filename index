    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #6EE7B7 0%, #3B82F6 50%, #9333EA 100%);
            min-height: 100vh;
            user-select: none;
            overflow-x: hidden;
        }

        h1, h2, h3, .font-heading {
            font-family: 'Fredoka', cursive;
        }

        /* Custom glassmorphism cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.15);
        }

        /* Pulsing & bouncy animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(2deg); }
        }

        .animate-float {
            animation: float 4s ease-in-out infinite;
        }

        @keyframes pop {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.8; }
            100% { transform: scale(0); opacity: 0; }
        }

        .balloon-pop {
            animation: pop 0.25s forwards ease-out;
        }

        /* Custom balloon styling */
        .balloon {
            transition: transform 0.1s ease;
            box-shadow: inset -8px -8px 0px rgba(0, 0, 0, 0.15), 0 10px 15px rgba(0,0,0,0.2);
        }

        .balloon::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-bottom: 12px solid inherit;
            filter: brightness(0.9);
        }

        .balloon::before {
            content: '';
            position: absolute;
            bottom: -28px;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 18px;
            background: rgba(255, 255, 255, 0.7);
        }

        /* Button click feedback */
        .btn-bounce {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-bounce:active {
            transform: scale(0.92);
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.6);
            border-radius: 4px;
        }
    </style>
</head>
